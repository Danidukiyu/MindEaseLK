{
  "name": "mindease-root",
  "version": "1.0.0",
  "scripts": {
    "setup": "node setup.js",
    "setup-test": "node setup-test-account.js",
    "docker:db": "docker-compose up --build -d ",
    "start:backend": "start cmd /k \"cd backend && npm start\"",
